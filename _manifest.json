{
  "manifest_version": 2,
  "id": "chartyr.jev-preprocessor",
  "version": "0.3.0",
  "name": "Jev Planner 前置处理器",
  "description": "在 Planner 请求前过滤无关启发式记忆，并标记外部客观事实属性；不判断是否回复，不指导措辞与语气。默认关闭。",
  "plugin_type": "extension",
  "author": {
    "name": "CharTyr",
    "url": "https://github.com/CharTyr"
  },
  "license": "GPL-v3.0-or-later",
  "host_application": {
    "min_version": "1.0.12",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.7.0",
    "max_version": "2.16.99"
  },
  "dependencies": [],
  "capabilities": [],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "display": {
    "icon": {
      "type": "lucide",
      "value": "filter"
    }
  },
  "urls": {
    "repository": "https://github.com/CharTyr/MaiBot-JevPreprocessor"
  }
}
